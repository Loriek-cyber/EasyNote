<Window x:Class="EasyNote.View.NoDbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasyNote.View"
        mc:Ignorable="d"
        Title="NoDbWindow" 
        Height="120" Width="150"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Border BorderBrush="#0B1120" BorderThickness="1" Padding="10" Background="#0B1120">
        <StackPanel VerticalAlignment="Center">
            <Button Content="Apri"
                    Height="40"
                    Margin="0,0,0,10"
                    Click="Load_OnClick"
                    Foreground="White"
                    Background="#0B1120"
                    />
            
            <Button Content="Crea"
                    Height="40"
                    Click="Create_OnClick"
                    Foreground="White"
                    Background="#0B1120"
                    />
        </StackPanel>
    </Border>
</Window>