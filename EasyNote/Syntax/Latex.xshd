<?xml version="1.0"?>
<SyntaxDefinition name="LaTeX" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

    <Color name="Comment" foreground="#6A9955" exampleText="% commento" />

    <Color name="Command" foreground="#4EC9B0" fontWeight="bold" exampleText="\documentclass" />

    <Color name="Keyword" foreground="#C586C0" fontWeight="bold" exampleText="\begin" />

    <Color name="Bracket" foreground="#FFD700" exampleText="{ }" />

    <Color name="MathMode" foreground="#CE9178" exampleText="$x^2$" />

    <Color name="Number" foreground="#B5CEA8" exampleText="3.14" />

    <Color name="Escaped" foreground="#DCDCDC" exampleText="\\" />

    <RuleSet>

        <!-- Commenti -->
        <Span color="Comment" begin="%" />

        <!-- Ambiente verbatim -->
        <Span color="Number" multiline="true">
            <Begin>\\begin\{verbatim\}</Begin>
            <End>\\end\{verbatim\}</End>
        </Span>

        <!-- Modalità matematica display -->
        <Span color="MathMode" multiline="true">
            <Begin>\$\$</Begin>
            <End>\$\$</End>
        </Span>

        <Span color="MathMode" multiline="true">
            <Begin>\\\[</Begin>
            <End>\\\]</End>
        </Span>

        <!-- Modalità matematica inline -->
        <Span color="MathMode" multiline="false">
            <Begin>\$</Begin>
            <End>\$</End>
        </Span>

        <!-- Comandi keyword principali -->
        <Rule color="Keyword">
            \\(begin|end|documentclass|usepackage|part|chapter|section|subsection|subsubsection|paragraph|subparagraph)\b
        </Rule>

        <!-- Altri comandi LaTeX -->
        <Rule color="Command">
            \\[a-zA-Z@]+
        </Rule>

        <!-- Parentesi e bracket -->
        <Rule color="Bracket">
            [\{\}\[\]\(\)]
        </Rule>

        <!-- Numeri -->
        <Rule color="Number">
            \b\d+(\.\d+)?\b
        </Rule>

        <!-- Caratteri escapati -->
        <Rule color="Escaped">
            \\[^a-zA-Z@]
        </Rule>

    </RuleSet>

</SyntaxDefinition>